# ── Database ─────────────────────────────────────────────────────────────
# Local dev (docker compose up -d):
DATABASE_URL="postgresql://growth_funnel:growth_funnel_dev_password@localhost:5432/growth_funnel_dev?schema=public"
# Public deployment: point this at a managed Postgres instead (Neon,
# Supabase, Railway, Render, etc.) via that provider's secret manager.
# Never commit a real production connection string.

# ── Meta Conversions API / Pixel ────────────────────────────────────────
# Leave disabled until you have a dedicated TEST pixel + system-user token.
# Never point this at a production/company pixel or token.
META_ENABLED=false
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
# Dev-only: force the Meta CAPI client to fail so you can observe retries.
META_SIMULATE_FAILURE=false

# ── Airtable ─────────────────────────────────────────────────────────────
# Leave disabled until you have a dedicated TEST base.
AIRTABLE_ENABLED=false
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
# Dev-only: force the Airtable client to fail so you can observe retries.
AIRTABLE_SIMULATE_FAILURE=false

# ── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
# CORS allow-list: the web app's origin. A comma-separated list is also
# accepted so a deployed preview + production domain can both be allowed.
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# ── Worker / job queue ───────────────────────────────────────────────────
MAX_JOB_ATTEMPTS=5
JOB_POLL_INTERVAL_MS=1000
JOB_LEASE_TIMEOUT_MS=60000

# ── Privacy ──────────────────────────────────────────────────────────────
PRIVACY_POLICY_VERSION=1.0.0

# ── Frontend (Vite — must be prefixed VITE_ to reach the browser bundle) ─
# Local dev:
VITE_API_URL=http://localhost:4000
# Public deployment: point this at the deployed API's own domain.
# VITE_API_URL=https://your-api-domain.example
VITE_META_PIXEL_ID=
VITE_PRIVACY_POLICY_VERSION=1.0.0
